# ==============================================================================
# ResQ (Disaster Response Coordination Hub) - .gitignore
# A pattern without a leading "/" matches at every directory level, so
# "node_modules/" also covers frontend/node_modules/ and any nested copy.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Secrets and environment files (never commit)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
env/
!.env.example
!frontend/.env.example
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
docker-compose.override.yml

# ------------------------------------------------------------------------------
# 2. Frontend (Next.js, Node.js, TypeScript)
# ------------------------------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.vercel/
.turbo/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# ------------------------------------------------------------------------------
# 3. Python backend, AI workers and models
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env.bak/
venv.bak/
develop-eggs/
.eggs/
*.egg-info/
*.egg
parts/
var/
wheels/
share/python-wheels/
*.manifest
*.spec
.ipynb_checkpoints/

# Model weights, checkpoints and generated artifacts (published on Hugging Face instead)
*.pt
*.pth
*.onnx
*.bin
*.safetensors
*.ckpt
*.h5
ai-workers/artifacts/
models/text_model/artifacts/
models/text_model/data/external/
models/**/outputs/
models/image_classifier/train/model_check/
models/text_classifier/MuRIL/muril_local_test_results/

# ------------------------------------------------------------------------------
# 4. Databases, backups and local state
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.rdb
local_data/
# Database dumps from scripts/db_backup.py contain personal data: never commit them
backups/
*.dump

# ------------------------------------------------------------------------------
# 5. Logs, test and coverage output, scratch files
# ------------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pip-log.txt
pip-delete-this-directory.txt
coverage/
htmlcov/
cover/
.coverage
.coverage.*
coverage.xml
*.cover
nosetests.xml
.cache
.tox/
.nox/
.hypothesis/
.pytest_cache/
.ruff_cache/
scratch/
scratch_*.*
audit.json
*.patch
*.diff
docs/perf/explain-local.md

# ------------------------------------------------------------------------------
# 6. Operating system files
# ------------------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump
*.lnk
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 7. Editors and IDEs (team VS Code settings stay shared)
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.code-workspace
.idea/
*.iws
*.iml
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.jupyter/

# ------------------------------------------------------------------------------
# 8. Personal working notes and local AI-assistant state
# ------------------------------------------------------------------------------
/remaining-work.md
/instructions.md
.claude/settings.local.json
.claude/worktrees/
.agents/settings.local.json
.ai/tasks/
.ai/reports/
.ai/handoffs/
