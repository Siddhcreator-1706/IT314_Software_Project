# ==============================================================================
# ResQ / DRCH backend - environment template (read by backend/app/config.py and docker-compose)
# Copy this file to .env and fill in the blanks:
#   cp .env.example .env
# Only variables you are likely to set are listed. Every other variable has a safe default;
# see docs/env-variables.md for the full list.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database - REQUIRED
# ------------------------------------------------------------------------------
# Credentials for the local PostGIS container (docker compose):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=drch_db

# Connection string used by the backend (Neon in staging/production):
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 2. Security - REQUIRED (all four are checked at startup when APP_ENV is staging/production)
# ------------------------------------------------------------------------------
# development | staging | production
APP_ENV=development

# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# 32+ characters, no placeholder words such as "change", "example" or "test-only".
JWT_SECRET=
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts staff TOTP secrets. Keep it fixed: changing it locks out every staff MFA.
MFA_ENCRYPTION_KEY=
# Bearer token for POST /api/v1/internal/ingest/run (same value as the GitHub secret).
INGEST_TOKEN=

# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. Donations (sandbox) - REQUIRED for the donation flow
# ------------------------------------------------------------------------------
# HMAC key for the mock payment gateway (generate like JWT_SECRET).
MOCK_GATEWAY_SECRET=

# Planned: live Razorpay test-mode gateway. The adapter exists (backend/app/payments) but is not
# wired into the donation routes yet, and PAYMENT_GATEWAY only accepts "mock" today.
# See docs/payment-gateway-findings.md. Leave these unset until it is wired.
# PAYMENT_GATEWAY=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 4. Ingestion feeds - optional
# ------------------------------------------------------------------------------
# Public SACHET CAP feed for Gujarat (IMD Ahmedabad, FSI); unset = SACHET adapter off. Uncomment to poll it locally.
# SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_gujarat.xml
# Live text signals stay off until the team approves live collection (docs/ingestion-sources.md).
NEWS_RSS_ENABLED=false
BLUESKY_SEARCH_ENABLED=false

# ------------------------------------------------------------------------------
# 5. AI triage service - optional (unset = triage returns UNAVAILABLE)
# ------------------------------------------------------------------------------
# AI_TRIAGE_URL=http://localhost:8001/triage
# AI_TRIAGE_TOKEN=            # same value must be set on the ai-workers service
# AI_LOW_CONFIDENCE_THRESHOLD=0.6
# AI_IMAGE_SERVICE_URL=http://localhost:8002   # ai-workers/model (not the backend's own port 8000)

# ------------------------------------------------------------------------------
# 6. Email (invitations and password reset) - optional locally, needed when deployed
# ------------------------------------------------------------------------------
# Leave SMTP_HOST empty locally: emails are only logged.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=
# FRONTEND_URL=http://localhost:3000   # base URL of links inside emails

# ------------------------------------------------------------------------------
# 7. Google - optional
# ------------------------------------------------------------------------------
# OAuth web client id for "Sign in with Google" (same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID).
# GOOGLE_CLIENT_ID=
# Geocoding key; without it the backend uses OpenStreetMap Nominatim.
# GOOGLE_MAPS_API_KEY=
