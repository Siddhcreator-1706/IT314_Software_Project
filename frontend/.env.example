# ==============================================================================
# ResQ frontend (Next.js) - environment template
# Copy this file to .env.local:
#   cp .env.example .env.local
# On Vercel, set the same names under Project -> Settings -> Environment Variables.
# ==============================================================================

# Backend base URL - REQUIRED
# - Local development: http://localhost:8000
# - Render: https://<your-backend>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
# Shows the sandbox (mock) donation flow on /donate. Needs APP_ENV=development or staging on the backend.
NEXT_PUBLIC_PAYMENT_SANDBOX=true

# Google OAuth web client id; empty = no "Sign in with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
