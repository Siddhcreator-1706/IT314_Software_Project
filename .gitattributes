# ==============================================================================
# Git Attributes configuration
# ==============================================================================

# Auto detect text files and perform LF normalization
* text=auto eol=lf

# ------------------------------------------------------------------------------
# Source code
# ------------------------------------------------------------------------------
*.js     text eol=lf
*.jsx    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.py     text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.html   text eol=lf
*.md     text eol=lf

# ------------------------------------------------------------------------------
# Configuration / Scripts
# ------------------------------------------------------------------------------
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf

# ------------------------------------------------------------------------------
# Windows-specific scripts (Keep CRLF for Powershell/Bat)
# ------------------------------------------------------------------------------
*.bat    text eol=crlf
*.ps1    text eol=crlf
*.cmd    text eol=crlf

# ------------------------------------------------------------------------------
# Binary files (Do not modify line endings)
# ------------------------------------------------------------------------------
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.mp4    binary
*.mov    binary
*.zip    binary
*.tar    binary
*.gz     binary
